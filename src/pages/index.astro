---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatMonthYear } from "@/lib/dateUtils";
import { getSeriesList } from "@/lib/jsonParser";

const projects = getSeriesList();
---

<BaseLayout
    title="CUE! — Project color reference"
    description="Browse exact character colors by project and copy them in HEX, RGB, and ASS formats."
>
    <section class="project-index" aria-labelledby="page-title">
        <header class="page-intro">
            <p class="kicker">Color reference</p>
            <h1 id="page-title">Projects.</h1>
        </header>

        <div class="project-list">
            {
                projects.map((project, index) => (
                    <a class="project-row" href={`/${project.slug}`}>
                        <span class="project-index-number">
                            {String(index + 1).padStart(2, "0")}
                        </span>

                        <div class="project-logo">
                            {project.logo && (
                                <img
                                    src={project.logo}
                                    alt=""
                                    width="148"
                                    height="112"
                                />
                            )}
                        </div>

                        <div class="project-copy">
                            <h2>{project.name}</h2>
                            <p>{project.desc}</p>
                            <p class="project-period">
                                <span>Period</span>
                                <time datetime={project.startDate}>
                                    {formatMonthYear(project.startDate)}
                                </time>
                                <span aria-hidden="true">—</span>
                                {
                                    project.endDate ? (
                                        <time datetime={project.endDate}>
                                            {formatMonthYear(project.endDate)}
                                        </time>
                                    ) : (
                                        <span>Present</span>
                                    )
                                }
                            </p>
                        </div>

                        <span class="project-arrow" aria-hidden="true">→</span>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
