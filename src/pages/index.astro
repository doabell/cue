---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSeriesList } from "@/lib/jsonParser";
import type { SerializedSeriesInfo } from "@/lib/types";

const seriesListRaw = getSeriesList();
const seriesList: SerializedSeriesInfo[] = seriesListRaw.map((series) => ({
    name: series.name,
    short: series.short,
    slug: series.slug,
    logo: series.logo,
    desc: series.desc,
}));
---
<BaseLayout
    seriesList={seriesList}
    title="CUE!"
    description="Color palettes for franchises."
>
    <div class="py-10">
        <h1 class="text-3xl font-bold text-center mb-12">CUE!</h1>
        <p class="text-center text-lg mb-8">Color palettes for franchises.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {seriesList.map((series) => (
                <a
                    href={`/${series.slug}`}
                    class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow"
                >
                    <div class="flex items-center mb-4">
                        {series.logo && (
                            <img
                                src={series.logo}
                                alt={`${series.name} logo`}
                                width={50}
                                height={50}
                                class="mr-3 self-center"
                                loading="lazy"
                            />
                        )}
                        <h2 class="text-xl font-semibold capitalize">{series.name}</h2>
                    </div>
                    <p class="text-gray-600 dark:text-gray-300">{series.desc}</p>
                </a>
            ))}
        </div>
    </div>
</BaseLayout>
