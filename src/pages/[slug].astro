---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ColorSeries from "@/components/ColorSeries";
import { getSeriesData, getSeriesList } from "@/lib/jsonParser";
import type { Color } from "@/lib/types";

export const prerender = true;

export const getStaticPaths = async () =>
    getSeriesList().map((series) => ({
        params: { slug: series.slug },
    }));

const { slug } = Astro.params;
const seriesInfo = getSeriesList().find((series) => series.slug === slug);

if (!seriesInfo) {
    Astro.response.status = 404;
}

const seriesData = seriesInfo
    ? (() => {
          const data = getSeriesData(seriesInfo.slug);
          return {
              colors: data.colors.map((color: Color) => ({
                  title: color.title,
                  subtitle: color.subtitle,
                  hex: color.hex,
                  logo: color.logo,
              })),
              logo: data.logo,
          };
      })()
    : null;

const pageTitle = seriesInfo
    ? `${seriesInfo.short} colors — CUE!`
    : "Project not found — CUE!";
const pageDescription = seriesInfo
    ? `Browse every ${seriesInfo.name} character color in HEX, RGB, and ASS formats.`
    : "The requested project could not be found.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
    {
        seriesInfo && seriesData ? (
            <ColorSeries
                client:load
                data={seriesData}
                name={seriesInfo.name}
                desc={seriesInfo.desc}
                startDate={seriesInfo.startDate}
                endDate={seriesInfo.endDate}
            />
        ) : (
            <section class="error-page">
                <p class="kicker">404</p>
                <h1>Project not found.</h1>
                <p>The requested project is not part of this reference.</p>
                <a class="text-link" href="/">
                    Return to projects →
                </a>
            </section>
        )
    }
</BaseLayout>
