---
import Navigation from "@/components/Navigation";
import { getSeriesList } from "@/lib/jsonParser";
import "@/styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "CUE!",
    description = "Display and copy character colors in multiple formats.",
} = Astro.props as Props;

const projects = getSeriesList();
const currentSlug = Astro.url.pathname.split("/").filter(Boolean)[0];
const currentYear = new Date().getFullYear();
const socialImage = new URL("/og.png", Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#f5f5f2" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content="CUE! project color reference" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <link rel="icon" href="/series/cue.png" />
        <script is:inline>
            const initializeTheme = () => {
                const storageKey = "theme";
                const root = document.documentElement;
                if (
                    !root.classList.contains("light") &&
                    !root.classList.contains("dark")
                ) {
                    try {
                        const stored = localStorage.getItem(storageKey);
                        const prefersDark = window
                            .matchMedia("(prefers-color-scheme: dark)")
                            .matches;
                        const theme =
                            stored === "light" || stored === "dark"
                                ? stored
                                : prefersDark
                                  ? "dark"
                                  : "light";
                        root.classList.add(theme);
                    } catch {
                        root.classList.add("light");
                    }
                }
            };

            initializeTheme();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>
        <Navigation projects={projects} currentSlug={currentSlug} client:load />
        <main id="main-content" class="site-main">
            <slot />
        </main>
        <footer class="site-footer">
            <div class="footer-inner">
                <p>CUE! — Project color reference</p>
                <p>© {currentYear}</p>
            </div>
        </footer>
    </body>
</html>
